# Resend MCP Server Configuration
# Copy this file to .env and fill in your actual values

# Required: Your Resend API Key
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=***REMOVED***

# Optional: Your sender email address from a verified domain
# If not provided, you'll be asked for it each time you send an email
SENDER_EMAIL_ADDRESS=tutor@fct.jualas.es

# Optional: Your reply-to email address
REPLY_TO_EMAIL_ADDRESS=your-reply-to@yourdomain.com
