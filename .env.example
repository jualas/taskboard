# Copiar a .env (no versionar). Plantilla completa con todas las opciones: backend/.env.example
#
# Secreto para firmar los JWT de sesión. Generar con: openssl rand -base64 48
JWT_SECRET=
# Permitir crear cuenta desde la pantalla de login
ALLOW_REGISTRATION=true
CORS_ORIGINS=*

# IA (opcional). Con DEEPSEEK_API_KEY usa DeepSeek; si está vacía, Ollama.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
