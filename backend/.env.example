# Despliegue Docker operativo: /mnt/datos/docker/taskboard-api/ (ver README de backend).
# Allí el compose fija DATABASE_URL (@postgres); este archivo sirve de plantilla para ese .env y para uvicorn local.
# Solo hace falta definirla aquí si usás uvicorn en el host contra Postgres en localhost u otro servidor.
# DATABASE_URL=postgresql://taskboard:taskboard@localhost:5432/taskboard

# Secreto para firmar los JWT de sesión (login). Cualquiera que lo conozca puede falsificar tokens.
# No uses una frase obvia ni la misma clave que en otros servicios.
# Generá uno nuevo en el servidor (64 bytes en base64, ~88 caracteres):
#   openssl rand -base64 48
# Copiá la salida completa en una sola línea, sin comillas.
JWT_SECRET=

JWT_EXPIRE_DAYS=7
# Registro abierto: true solo en local. En una instancia publicada en Internet, false.
ALLOW_REGISTRATION=true
# Correos (coma) que pueden vincular carpetas del servidor y usar Cursor Agent. Vacío = nadie.
WORKSPACE_ADMIN_EMAILS=
# Swagger en /docs (solo desarrollo)
ENABLE_DOCS=false
CORS_ORIGINS=*

# --- IA: DeepSeek (recomendado en equipos con poco rendimiento; sin modelo local) ---
# Clave desde https://platform.deepseek.com/ (o el panel de API que uses).
# Con la clave informada, el backend usa DeepSeek y no intenta Ollama.
# Motor de «Sugerir con IA» y del chat: auto | deepseek | ollama | agent (docs/IA_ASISTENTE.md)
AI_ENGINE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_MAX_TOKENS_PLAN=8192

# --- IA: Ollama (solo si DEEPSEEK_API_KEY está vacío; exige CPU/RAM en el equipo) ---
# En contenedor Docker: http://host.docker.internal:11434 + extra_hosts host-gateway en compose.
# Vacío = sin modelo local: el chat responde 503 con un mensaje claro a quien no tenga otro motor.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
# Timeouts HTTP del API hacia Ollama (segundos). El plan de proyecto necesita lecturas largas.
OLLAMA_TIMEOUT_SEC=180
OLLAMA_TIMEOUT_PLAN_SEC=600
DEEPSEEK_TIMEOUT_SEC=120
DEEPSEEK_TIMEOUT_PLAN_SEC=300

# Carpetas permitidas para workspace_path de proyectos (montar en el contenedor taskboard-api).
# Separadas por coma. Deben coincidir con rutas reales en el mini PC.
WORKSPACE_ROOTS=/mnt/datos/docker,/mnt/datos/Proyectos,/mnt/datos/nextcloud/nextcloud-service/nextcloud-data/data/jualas/files/Proyectos,/home/jualas/datos/docker,/home/jualas/datos/Proyectos

# Fase 2: cron interno de snapshots (asyncio en el contenedor API)
WORKSPACE_SNAPSHOT_ENABLED=true
WORKSPACE_SNAPSHOT_INTERVAL_MIN=30
# Sugerencias IA extra cuando cambia el commit (además de heurísticas locales)
WORKSPACE_AI_SUGGESTIONS=true

# --- Claude Code (modo Agent del panel; docs/CLAUDE_CODE_AGENTE.md) ---
# Solo para WORKSPACE_ADMIN_EMAILS. En Docker: montar el binario `claude`, un HOME propio y el MCP.
CLAUDE_CODE_ENABLED=false
# Token de `claude setup-token` (lo genera el usuario; nunca en el repo).
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_HOME=/home/agente
CLAUDE_CODE_DEFAULT_WORKSPACE=/mnt/datos/Proyectos/taskboard
CLAUDE_CODE_MODEL=
CLAUDE_CODE_TIMEOUT_SEC=1800
CLAUDE_CODE_MAX_TURNS=60
CLAUDE_CODE_MAX_BUDGET_USD=3
CLAUDE_CODE_MCP_SERVER=/opt/mcp-taskboard/server.py
CLAUDE_CODE_TOKEN_MINUTES=60
AGENT_FALLBACK_LLM=false

# Export TASKBOARD.md al workspace (IDE / CLI). Requiere montajes :rw en docker-compose.
TASKBOARD_MD_FILENAME=TASKBOARD.md
# Regenerar automáticamente tras crear/editar/borrar tareas (puede ser frecuente).
TASKBOARD_MD_AUTO_EXPORT=false
