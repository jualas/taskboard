# Copiar en el PORTÁTIL a: ~/.config/taskboard/mcp.env
# chmod 600 ~/.config/taskboard/mcp.env
#
# API del mini PC (misma red LAN). Si usas túnel SSH, puedes poner http://127.0.0.1:8101
# y hacer: ssh -N -L 8101:127.0.0.1:8101 usuario@<IP-LAN-SERVIDOR>

API_BASE_URL=http://<IP-LAN-SERVIDOR>:8101
API_AUTH_EMAIL=tu@correo
API_AUTH_PASSWORD=tu_clave_taskboard

# Opcional: JWT ya obtenido (evita login en cada arranque)
# API_BEARER_TOKEN=
