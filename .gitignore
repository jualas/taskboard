# IDE / agentes
# Las rules/skills del hub Skills-Rules se instalan en local y no se versionan;
# solo se publican las propias de este repo (excepciones !). Añadir aquí las nuevas.
.idea/
.cursor/*
!.cursor/rules/
.cursor/rules/*
!.cursor/rules/clean-architecture.mdc
!.cursor/skills/
.cursor/skills/*
!.cursor/skills/flutter-clean-architecture/
**/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/flutter-clean-architecture

# Secretos y entornos locales (plantillas *.example sí van al repo)
**/.env*
!**/.env.example
!**/env.example

# Flutter / frontend
frontend/build/
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.pub-cache-docker/
frontend/.pub/
frontend/coverage/
*.iml

# Python / backend
backend/.venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node (cspell local, MCP, etc.)
node_modules/
**/node_modules/

# Respuestas de prueba manual (no versionar)
**/*_test_resp*.json
*.tar.gz
# Logs y sistema
*.log
.DS_Store
Thumbs.db

# Entornos virtuales (MCP, scripts)
**/.venv/

# --- seguridad (secure-repo) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
.cursor/mcp.json
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
__pycache__/
*.pyc
trivy*.sarif
gitleaks-report*.json
